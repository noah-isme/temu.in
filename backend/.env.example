APP_ENV=development
# Log level: debug | info | warn | error (invalid values fall back to info).
# APP_ENV development/dev/local/test logs text; anything else logs JSON.
LOG_LEVEL=info
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/temu_in?sslmode=disable
REDIS_URL=redis://:redis@redis:6379/0
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@temu.in
SENDGRID_BOOKING_TEMPLATE_ID=
SENDGRID_CANCELLATION_TEMPLATE_ID=
SENDGRID_REMINDER_TEMPLATE_ID=
SENDGRID_RECEIPT_TEMPLATE_ID=
SENDGRID_AUTH_TEMPLATE_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
# Public frontend origin used in password-reset and email-verification links
# (trailing slash is trimmed).
FRONTEND_BASE_URL=http://localhost:5173

# --- Test-only variables (not read by the server) ---
# Admin connection for integration tests; the role needs CREATEDB.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/temu_in_test?sslmode=disable
# Fail instead of skipping integration tests when TEST_DATABASE_URL is unset.
# REQUIRE_INTEGRATION=1
# Opt-in sandbox tests (skipped unless set; never put real values here).
# Midtrans: `go test ./internal/payment/ -run Sandbox -v` creates a 10000 IDR
# Snap transaction in the Midtrans sandbox and checks status/signature logic.
# MIDTRANS_SANDBOX_SERVER_KEY=
# MIDTRANS_SANDBOX_CLIENT_KEY=
# SendGrid: `go test ./internal/notification/ -run Sandbox -v` sends one
# request with mail_settings.sandbox_mode on (validated, never delivered); the
# from address must be a verified sender.
# SENDGRID_SANDBOX_API_KEY=
# SENDGRID_SANDBOX_FROM_EMAIL=
# SENDGRID_SANDBOX_TO_EMAIL=
